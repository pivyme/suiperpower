# Local-mock defaults so the autonomous build loop can iterate without external dep pauses.
# auto-build.sh copies this to .env if .env is missing.

# Empty Convex URL: telemetry calls become no-ops at runtime, the CLI still functions.
# When you wire a real Convex backend, replace these with values from `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Default install host points at the staging/local domain. Production setup.sh hosts at suiperpower.dev.
SUIPERPOWER_INSTALL_HOST=https://suiperpower.dev/setup.sh

# Telemetry off in local mock mode so loop iterations never hit the network.
SUIPERPOWER_TELEMETRY=off

# Repo handle placeholder, swap before publish.
SUIPERPOWER_GH_REPO=your-handle/suiperpower
