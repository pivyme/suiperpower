{
  "name": "suiperpower-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Suiperpower monorepo: core CLI/skills, convex backend, web.",
  "type": "module",
  "scripts": {
    "dev": "pnpm -F suiperpower dev",
    "build": "pnpm -F suiperpower build",
    "setup": "pnpm -F suiperpower setup",
    "typecheck": "pnpm -F suiperpower typecheck",
    "preamble:check": "pnpm -F suiperpower preamble:check",
    "package:skills": "pnpm -F suiperpower package:skills",
    "lint:skills": "pnpm -F suiperpower lint:skills",
    "lint:catalog": "pnpm -F suiperpower lint:catalog",
    "test": "pnpm -F suiperpower test",
    "test:install": "pnpm -F suiperpower test:install",
    "skills:lock": "pnpm -F suiperpower skills:lock",
    "marketplace:gen": "pnpm -F suiperpower marketplace:gen",
    "publish:dry": "pnpm -F suiperpower publish:dry"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
