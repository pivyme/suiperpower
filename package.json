{
  "name": "suiperpower-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Suiperpower monorepo: core CLI/skills, convex backend, web.",
  "type": "module",
  "scripts": {
    "dev": "pnpm -F @pivyme/suiperpower dev",
    "build": "pnpm -F @pivyme/suiperpower build",
    "setup": "pnpm -F @pivyme/suiperpower setup",
    "typecheck": "pnpm -F @pivyme/suiperpower typecheck",
    "preamble:check": "pnpm -F @pivyme/suiperpower preamble:check",
    "package:skills": "pnpm -F @pivyme/suiperpower package:skills",
    "skills:watch": "pnpm -F @pivyme/suiperpower skills:watch",
    "web:dev": "pnpm -F web dev",
    "web:build": "pnpm -F web build",
    "lint:skills": "pnpm -F @pivyme/suiperpower lint:skills",
    "lint:catalog": "pnpm -F @pivyme/suiperpower lint:catalog",
    "test": "pnpm -F @pivyme/suiperpower test",
    "test:install": "pnpm -F @pivyme/suiperpower test:install",
    "test:telemetry": "pnpm -F @pivyme/suiperpower test:telemetry",
    "skills:lock": "pnpm -F @pivyme/suiperpower skills:lock",
    "marketplace:gen": "pnpm -F @pivyme/suiperpower marketplace:gen",
    "publish:dry": "pnpm -F @pivyme/suiperpower publish:dry",
    "lint": "eslint core/cli/ core/scripts/",
    "format": "prettier --check core/cli/ core/scripts/",
    "format:fix": "prettier --write core/cli/ core/scripts/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.6.0",
    "prettier": "^3.5.3",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.60.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "js-cookie": "^3.0.7",
      "qs": "^6.15.2",
      "ws": "^8.20.1"
    }
  }
}
