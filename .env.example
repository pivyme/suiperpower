# Suiperpower env vars
# Copy to .env for local dev. Never commit .env (gitignored).

# Convex backend, telemetry + feedback. See plans/13-CONVEX-BACKEND.md.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Override the curl install host. Defaults to https://suiperpower.dev/setup.sh.
SUIPERPOWER_INSTALL_HOST=

# Override the runtime telemetry tier. One of: off | anonymous | community.
# Defaults to whatever ~/.suiperpower/config.json says, or anonymous if absent.
SUIPERPOWER_TELEMETRY=

# Optional: pin a specific GitHub handle/repo when generating install banners or release URLs.
SUIPERPOWER_GH_REPO=
