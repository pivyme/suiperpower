{
  "name": "suiperpower",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Skills, knowledge, and a CLI for shipping production Sui products. think. build. ship.",
  "type": "module",
  "bin": {
    "suiperpower": "./dist/cli/index.js",
    "suiper": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "skills/learn/",
    "skills/idea/",
    "skills/build/",
    "skills/ship/",
    "skills/grow/",
    "skills/data/",
    "skills/README.md",
    "skills/SKILL_ROUTER.md",
    "cli/data/",
    "install.sh",
    "skills-lock.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/index.js",
    "dev": "tsx cli/index.ts",
    "setup": "./setup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preamble:check": "tsx scripts/inject-preamble.ts --check",
    "package:skills": "./scripts/package-skills.sh && tsx scripts/generate-skills-index.ts",
    "skills:watch": "tsx scripts/watch-skills.ts",
    "lint:skills": "tsx scripts/lint-skills.ts",
    "lint:catalog": "tsx scripts/lint-catalog.ts",
    "setup:sync": "./scripts/check-setup-sync.sh --write",
    "setup:check": "./scripts/check-setup-sync.sh",
    "test": "pnpm typecheck && pnpm -w lint && pnpm lint:skills && pnpm lint:catalog && pnpm preamble:check && pnpm setup:check",
    "test:install": "./scripts/test-install.sh",
    "test:telemetry": "node --env-file=../.env --import tsx scripts/test-telemetry.ts",
    "skills:lock": "tsx scripts/generate-skills-lock.ts",
    "marketplace:gen": "tsx scripts/generate-marketplace.ts",
    "publish:dry": "tsx scripts/publish.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
