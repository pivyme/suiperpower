#!/usr/bin/env bash
# Local-dev convenience. Runs the local install.sh against the sources in this repo.
# Useful when iterating before publishing to npm. For end users, the canonical entry
# is `curl -fsSL https://suiperpower.dev/setup.sh | bash`.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
cd "$SCRIPT_DIR"

if [ ! -f install.sh ]; then
  printf "  install.sh not found in %s\n" "$SCRIPT_DIR" >&2
  exit 1
fi

# Pass through args (e.g. --vendor) so `./setup --vendor` matches user expectations.
exec bash install.sh "$@"
